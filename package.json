{
  "name": "ai-bridge",
  "version": "0.1.0",
  "description": "AI Bridge: local loop between Claude Code CLI (executor) and Codex CLI (reviewer) — CLI + Electron desktop app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "ai-bridge": "node src/cli.ts",
    "doctor": "node src/cli.ts doctor",
    "test": "node --import ./tests/support/register-tsx.mjs --test \"tests/**/*.test.ts\" \"tests/**/*.test.tsx\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json",
    "build": "node scripts/desktop/build.ts",
    "desktop": "node scripts/desktop/build.ts --dev && electron .",
    "package:win": "node scripts/desktop/build.ts && node scripts/desktop/package-win.ts"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "44.4.5",
    "esbuild": "0.28.2",
    "happy-dom": "20.14.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "main": "dist-desktop/main.mjs"
}
